# WanWang environment variables
# Copy to .env.local and fill in the values.

# Supabase (server-side only; create a free project at https://supabase.com)
SUPABASE_URL=your_supabase_project_url
# service_role / secret key: NEVER prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public base URL, used for the link preview image. Read at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email shown on /privacy for personal data requests. Set this in production:
# without it the page has no contact section.
NEXT_PUBLIC_PRIVACY_CONTACT=

# Dev without Supabase uses ./data/*.json. In production a missing DB config is a hard error.

# Lets Vercel Cron call /api/cron/sweep-files (see vercel.json), which deletes attached files that
# no longer belong to any answer. Set a long random value in production: without it the sweep
# never runs and files of expired events stay in storage.
CRON_SECRET=
