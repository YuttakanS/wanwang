# WanWang environment variables
# Copy to .env.local and fill in the values.

# Supabase (server-side only; create a free project at https://supabase.com)
SUPABASE_URL=your_supabase_project_url
# service_role / secret key: NEVER prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public base URL (used for share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev without Supabase uses ./data/*.json. In production a missing DB config is a hard error.
